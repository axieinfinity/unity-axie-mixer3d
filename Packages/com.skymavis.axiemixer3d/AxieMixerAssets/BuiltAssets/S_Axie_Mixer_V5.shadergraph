        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GetMainLight",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if defined(UNIVERSAL_PIPELINE_CORE_INCLUDED) && !defined(SHADERGRAPH_PREVIEW)\n    Light mainLight = GetMainLight();\n    color = mainLight.color;\n    direction = mainLight.direction;\n#else\n    color = 1.0;\n    direction = normalize(half3(-15, 80, -30));\n#endif\n"
}

